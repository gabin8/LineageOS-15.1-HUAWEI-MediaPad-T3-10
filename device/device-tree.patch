new file mode 100644
index 0000000..3b19ea0
--- /dev/null
+++ b/sepolicy/oeminfo_nvm.te
@@ -0,0 +1,27 @@
+# Huawei oeminfo_nvm_server: serves the oeminfo partition over /dev/socket/oeminfo_nvm.
+# The sensors HAL reads the factory accelerometer calibration through it (liboeminfo rmt_oeminfo_read).
+type oeminfo_nvm, domain;
+type oeminfo_nvm_exec, exec_type, vendor_file_type, file_type;
+type oeminfo_nvm_socket, file_type;
+# /dev/oinv: the daemon hands each request's data over in a file there, chowned to the client
+type oeminfo_nvm_device, dev_type;
+init_daemon_domain(oeminfo_nvm)
+
+allow oeminfo_nvm block_device:dir search;
+allow oeminfo_nvm block_device:lnk_file read;
+allow oeminfo_nvm oeminfo_block_device:blk_file rw_file_perms;
+
+allow oeminfo_nvm socket_device:dir rw_dir_perms;
+allow oeminfo_nvm oeminfo_nvm_socket:sock_file { create setattr unlink };
+type_transition oeminfo_nvm socket_device:sock_file oeminfo_nvm_socket;
+
+allow oeminfo_nvm device:dir { write add_name };
+type_transition oeminfo_nvm device:dir oeminfo_nvm_device "oinv";
+allow oeminfo_nvm oeminfo_nvm_device:dir create_dir_perms;
+allow oeminfo_nvm oeminfo_nvm_device:file create_file_perms;
+allow oeminfo_nvm self:capability { chown fowner fsetid };
+
+# Only the sensors HAL talks to it (the daemon can also write oeminfo).
+unix_socket_connect(hal_sensors_default, oeminfo_nvm, oeminfo_nvm)
+allow hal_sensors_default oeminfo_nvm_device:dir rw_dir_perms;
+allow hal_sensors_default oeminfo_nvm_device:file { r_file_perms unlink };
diff --git a/sepolicy/perfd.te b/sepolicy/perfd.te
new file mode 100644
index 0000000..a748f08
--- /dev/null
+++ b/sepolicy/perfd.te
@@ -0,0 +1,47 @@
+# Qualcomm perfd (Nougat build): CPU/bus boosts for the power HAL (touch, launch), audio, camera and
+# video. Rules from device/qcom/sepolicy legacy-common/perfd.te; stock started it from its ramdisk.
+type perfd, domain;
+type perfd_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(perfd)
+
+allow perfd self:capability { fsetid kill };
+allow perfd {
+    sysfs_devices_system_cpu
+    sysfs_cpu_online
+    sysfs_scsi_host
+    proc
+    sysfs
+}:file rw_file_perms;
+r_dir_file(perfd, sysfs_devfreq)
+allow perfd sysfs_devfreq:file write;
+r_dir_file(perfd, sysfs_msm_perf)
+allow perfd sysfs_msm_perf:file write;
+r_dir_file(perfd, sysfs_msm_power)
+allow perfd sysfs_msm_power:file write;
+allow perfd sysfs_lib:file w_file_perms;
+r_dir_file(perfd, sysfs_kgsl)
+allow perfd sysfs_kgsl:file write;
+allow perfd sysfs_thermal:dir search;
+allow perfd sysfs_thermal:file w_file_perms;
+allow perfd mpctl_socket:dir rw_dir_perms;
+allow perfd mpctl_socket:sock_file create_file_perms;
+allow perfd mpctl_data_file:dir rw_dir_perms;
+allow perfd mpctl_data_file:file create_file_perms;
+unix_socket_connect(perfd, thermal, thermal-engine)
+allow perfd domain:process signull;
+set_prop(perfd, freq_prop)
+allow perfd cgroup:file r_file_perms;
+allow perfd sysfs:dir r_dir_perms;
+r_dir_file(perfd, hal_power_default)
+r_dir_file(perfd, sysfs_mmc_host)
+
+# Clients: system components only (Qualcomm's legacy policy also let every app connect).
+unix_socket_connect(hal_power_default, mpctl, perfd)
+unix_socket_connect(hal_audio_default, mpctl, perfd)
+unix_socket_connect(hal_camera_default, mpctl, perfd)
+unix_socket_connect(mediacodec, mpctl, perfd)
+unix_socket_connect(cameraserver, mpctl, perfd)
+unix_socket_connect(audioserver, mpctl, perfd)
+unix_socket_connect(surfaceflinger, mpctl, perfd)
+unix_socket_connect(hal_graphics_composer_default, mpctl, perfd)
+
