diff --git a/board/wlan.mk b/board/wlan.mk
index 2f798a2..a106ff8 100644
--- a/board/wlan.mk
+++ b/board/wlan.mk
@@ -15,3 +15,13 @@ WIFI_DRIVER_FW_PATH_AP := "ap"
 WIFI_DRIVER_FW_PATH_STA := "sta"
 
 WPA_SUPPLICANT_VERSION := VER_0_8_X
+
+# prima is built into the kernel and started through Huawei's /proc/wifi_built_in/wifi_start,
+# like stock (whose HAL sets wlan.driver.trigger=start|stop and init writes that node).
+# The HAL starts the driver on Wi-Fi enable, waits for wlan0, and stops it on Wi-Fi disable.
+# init.wifi.sh still pre-starts it at boot (stock: wifi_driver_init); a second start is a
+# no-op in prima.
+WIFI_DRIVER_STATE_CTRL_PARAM := "/proc/wifi_built_in/wifi_start"
+WIFI_DRIVER_STATE_ON := "start"
+WIFI_DRIVER_STATE_OFF := "stop"
+WIFI_DRIVER_OPERSTATE_PATH := "/sys/class/net/wlan0/operstate"
diff --git a/device.mk b/device.mk
index 9d61cfe..2123205 100644
--- a/device.mk
+++ b/device.mk
@@ -26,3 +26,30 @@ include $(DEVICE_PATH)/product/*.mk
 
 # Inherit proprietary files
 $(call inherit-product-if-exists, vendor/huawei/ags_w09/ags_w09-vendor.mk)
+
+# Tablet
+PRODUCT_CHARACTERISTICS := tablet
+
+# Lights (CAF liblight, replaces the sleeping Huawei blob)
+PRODUCT_PACKAGES += \
+    lights.msm8937
+
+# Wi-Fi only (stock sets ro.radio.noril=true; no dialer/SMS apps on stock)
+PRODUCT_PROPERTY_OVERRIDES += \
+    ro.radio.noril=true
+
+# TeleService binds to it; stock ships it
+PRODUCT_PACKAGES += \
+    CarrierConfig
+
+# Huawei wcnss_service copies its WCNSS cfg from /system/etc/wifi (stock EMUI file)
+PRODUCT_COPY_FILES += \
+    $(DEVICE_PATH)/configs/wifi/WCNSS_qcom_cfg_huawei.ini:$(TARGET_COPY_OUT_SYSTEM)/etc/wifi/WCNSS_qcom_cfg.ini
+
+# logd.klogd spins at 100% CPU on this 3.18 kernel; kernel log stays available via dmesg
+PRODUCT_PROPERTY_OVERRIDES += \
+    ro.logd.kernel=false
+
+# Shims for Huawei vendor blobs (sensors HAL: libizat_core needs get_process_name)
+PRODUCT_PACKAGES += \
+    libshim_procname
