# Block devices
/dev/block/bootdevice/by-name/persist		u:object_r:persist_block_device:s0
/dev/block/bootdevice/by-name/userdata		u:object_r:userdata_block_device:s0

# Data files
/data/misc/netmgr/log\.txt			u:object_r:netmgrd_data_file:s0

# Ir
/dev/lirc[0-9]*					u:object_r:lirc_device:s0

# Init
/(vendor|system/vendor)/bin/init\.qcom\.graphics\.sh		u:object_r:init_graphics_exec:s0

# Light HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.light@2\.0-service\.xiaomi_8917 u:object_r:hal_light_default_exec:s0

# Partitions: by-name links under the platform path, and under bootdevice once
# androidboot.bootdevice is on the kernel cmdline
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/system	u:object_r:system_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/vendor	u:object_r:vendor_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/userdata	u:object_r:userdata_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/cache	u:object_r:cache_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/persist	u:object_r:persist_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/misc	u:object_r:misc_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/boot	u:object_r:boot_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/recovery	u:object_r:recovery_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/modem	u:object_r:modem_block_device:s0
/dev/block/(bootdevice|platform/soc/7824900\.sdhci)/by-name/oeminfo	u:object_r:oeminfo_block_device:s0

# Huawei kernel log nodes
/dev/hwlog_[a-z]+				u:object_r:hwlog_device:s0
