service sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    class hal
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND SYS_NICE
    # Huawei libizat_core.so (pulled in by sensors.ssc.so -> liblocationservice.so) imports
    # get_process_name(), which A8.1 libcutils no longer exports -> multihal dlopen fails.
    setenv LD_PRELOAD /vendor/lib64/libshim_procname.so
