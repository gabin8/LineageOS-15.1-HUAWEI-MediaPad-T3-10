on early-init
    write /proc/sys/kernel/print-fatal-signals 1
on fs
    mount_all /fstab.qcom
    # FunctionFS backing for adb: this kernel's android_usb adb function is ffs-backed;
    # without a mounted functionfs the adb descriptor is empty -> host "error -32". (mirrors recovery)
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    # Device has 4 cores (0-3). init.rc copies the (initially empty) root cpuset into the
    # child cpusets, leaving cpus="" -> system_server setThreadGroupAndCpuset() throws and
    # crash-loops (DisplayManagerService). Populate them explicitly.
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/foreground/mems 0
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/background/mems 0
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/system-background/mems 0
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/top-app/mems 0

# Generic light@2.0 HAL (replaces aw2013 variant which opens a nonexistent /sys/class/leds/blue)
service light-hal-2-0 /vendor/bin/hw/android.hardware.light@2.0-service
    class hal
    user system
    group system

service wifi-bringup /system/bin/sh /init.wifi.sh
    class late_start
    user root
    group root system wifi
    seclabel u:r:wifi_bringup:s0
    oneshot

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/wifi/nvbin 0770 wifi wifi
    copy /vendor/etc/wifi/WCNSS_hw_wlan_nv_ags_w09.bin /data/misc/wifi/nvbin/msm8937_303_0x00_0x01_0x00_nv.bin
    chown wifi wifi /data/misc/wifi/nvbin/msm8937_303_0x00_0x01_0x00_nv.bin
    chmod 0644 /data/misc/wifi/nvbin/msm8937_303_0x00_0x01_0x00_nv.bin

on boot
    chown wifi wifi /sys/module/wlan/parameters/fwpath
    chown wifi wifi /proc/wifi_built_in/wifi_start
    chmod 0220 /proc/wifi_built_in/wifi_start
    chown system system /sys/class/graphics/fb0/lcd_cabc_mode
    chmod 0664 /sys/class/graphics/fb0/lcd_cabc_mode

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/vendor/etc/wifi/p2p_supplicant_overlay.conf -N \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/vendor/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -puse_p2p_group_interface=1 -dd \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

on fs
    write /sys/module/firmware_class/parameters/path /firmware/image

on post-fs-data
    chmod 0775 /persist/sensors
    chmod 0664 /persist/sensors/sensors_settings
    chown system root /persist/sensors/sensors_settings
    mkdir /data/misc/sensors 0775 system system

on early-boot
    start irsc_util
    write /sys/bus/msm_subsys/devices/subsys1/restart_level related
    write /sys/kernel/boot_adsp/boot 1
    start sensors

service irsc_util /vendor/bin/irsc_util /vendor/etc/sec_config
    class core
    user root
    disabled
    oneshot

service sensors /vendor/bin/sensors.qcom
    class core
    user root
    group root system wakelock
    disabled

on post-fs-data
    # Create folder for mm-qcamera-daemon
    mkdir /data/misc/camera 0770 camera camera
    mkdir /data/vendor/camera 0770 camera camera
    # Create /data/time folder for time-services
    mkdir /data/time/ 0700 system system

service thermal-engine /vendor/bin/thermal-engine -c ${sys.qcom.thermalcfg:-/vendor/etc/thermal-engine.conf}
    class main
    user root
    socket thermal-send-client stream 0666 system system
    socket thermal-recv-client stream 0660 system system
    socket thermal-recv-passive-client stream 0666 system system
    socket thermal-send-rule stream 0660 system system
    group root

service time_daemon /vendor/bin/time_daemon
    class main
    user root
    group root

service qcamerasvr /vendor/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics

on early-init
    mount debugfs debugfs /sys/kernel/debug mode=0755

on init
    symlink /dev/block/platform/soc/7824900.sdhci /dev/block/bootdevice

on post-fs
    start oeminfo_nvm

service oeminfo_nvm /vendor/bin/oeminfo_nvm_server
    class core
    ioprio rt 4
    disabled

on post-fs-data
    mkdir /data/system/perfd 0770 root system
    chmod 2770 /data/system/perfd
    rm /data/system/perfd/default_values
    start perfd

service perfd /vendor/bin/perfd
    class main
    user root
    group root readproc
    disabled
    socket perfd seqpacket 0666 root system

on property:sys.boot_completed=1
    start qcom-post-boot

service qcom-post-boot /vendor/bin/init.qcom.post_boot.sh
    class late_start
    user root
    disabled
    oneshot
