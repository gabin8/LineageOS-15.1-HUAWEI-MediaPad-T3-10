# ramdisk fstab for second-stage mount_all (full platform by-name paths, verified present)
/dev/block/platform/soc/7824900.sdhci/by-name/system     /system   ext4   ro,barrier=1                          wait
/dev/block/platform/soc/7824900.sdhci/by-name/vendor     /vendor   ext4   ro,barrier=1                          wait
/dev/block/platform/soc/7824900.sdhci/by-name/cache      /cache    ext4   nosuid,nodev,noatime                  wait,formattable
/dev/block/platform/soc/7824900.sdhci/by-name/userdata   /data     f2fs   rw,nosuid,nodev,noatime               wait,formattable,encryptable=footer
# ADSP firmware (sensor core + audio Q6) and the sensor registry must be available at
# early-boot, before the ADSP is booted and before the sensors HAL starts (class hal).
/dev/block/platform/soc/7824900.sdhci/by-name/modem      /firmware vfat   ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/platform/soc/7824900.sdhci/by-name/persist    /persist  ext4   nosuid,nodev,noatime                  wait
# Huawei product partition (stock layout): the audio HAL's agassi ACDB tuning, mixer paths and
# platform info live in /product/etc/acdbdata/agassi
/dev/block/platform/soc/7824900.sdhci/by-name/product    /product  ext4   ro,barrier=1                          wait
