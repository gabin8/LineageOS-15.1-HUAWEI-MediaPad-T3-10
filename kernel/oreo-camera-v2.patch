+{
+	uint32_t csid_pkg = 0;
+	int i = 0;
+	struct csid_device *csid_dev = NULL;
+	struct v4l2_subdev *subdev_csids[MAX_CSID_NUM] = {NULL};
+	msm_sd_get_subdevs(subdev_csids,MAX_CSID_NUM,"msm_csid");
