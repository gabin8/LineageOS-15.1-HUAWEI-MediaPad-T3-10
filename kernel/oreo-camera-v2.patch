index 00000000..8c8eb41c
--- /dev/null
+++ b/drivers/media/platform/msm/camera_v2/sensor/flash/msm_subflash.c
@@ -0,0 +1,1272 @@
+/* Copyright (c) 2009-2017, The Linux Foundation. All rights reserved.
+ *
